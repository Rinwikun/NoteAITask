<?xml version="1.0" encoding="utf-8"?>
<Obfuscator>
  <Var name="InPath" value="." />
  <Var name="OutPath" value=".\protected" />
  <Var name="Path" value="." />

  <!-- Matikan HideStrings untuk mencegah NullReferenceException pada Avalonia XAML -->
  <Var name="HideStrings" value="false" />

  <!-- Kebijakan Proteksi Simbol -->
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameFields" value="true" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="ReuseNames" value="true" />
  <Var name="Optimize" value="true" />

  <Module file="$(InPath)\NoteAITask.dll" />
</Obfuscator>