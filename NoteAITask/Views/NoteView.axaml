<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoteAITask.ViewModels"
             x:Class="NoteAITask.Views.NoteView"
             x:DataType="vm:NoteViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- HEADER TOOLBAR -->
        <Border Grid.Row="0" Background="#1E1E2E" Padding="10,8" CornerRadius="8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="📝 Note" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="#45475A" VerticalAlignment="Center"/>
                    <TextBlock Text="Tip: Klik kanan pada Folder/File untuk opsi Rename, Undo, &amp; Hapus" 
                               Foreground="#89B4FA" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Dynamic Mode Buttons State -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Mode View:" Foreground="#A6ADC8" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button Content="📊 Split View - 3 Kolom" Command="{Binding SwitchToViewACommand}" 
                            Background="{Binding ViewABackground}" Foreground="White" FontWeight="Bold" CornerRadius="4"/>
                    <Button Content="📁 Explorer View - Bertingkat" Command="{Binding SwitchToViewBCommand}" 
                            Background="{Binding ViewBBackground}" Foreground="White" FontWeight="Bold" CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- AREA KONTEN TAMPILAN -->
        <Grid Grid.Row="1">
            
            <!-- ========================================== -->
            <!-- TAMPILAN A: SPLIT VIEW (3 KOLOM)           -->
            <!-- ========================================== -->
            <Grid ColumnDefinitions="200, 220, *" IsVisible="{Binding IsViewA}">
                <!-- Kolom 1: Folder -->
                <Border Grid.Column="0" Background="#1E1E2E" CornerRadius="8" Margin="0,0,8,0" Padding="10">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Row="0" Text="📁 Folder" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" Background="Transparent" Foreground="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="✏️ Ganti Nama Folder" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).ShowRenameFolderDialogCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="🗑️ Hapus Folder" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).DeleteFolderCommand}"/>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="2" Content="➕ Folder Baru" Command="{Binding CreateNewFolderCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#313244" Foreground="White" CornerRadius="6"/>
                    </Grid>
                </Border>

                <!-- Kolom 2: File -->
                <Border Grid.Column="1" Background="#1E1E2E" CornerRadius="8" Margin="0,0,8,0" Padding="10">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Row="0" Text="📝 File Note" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,10"/>
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedFolder.Notes}" SelectedItem="{Binding SelectedNote}" Background="Transparent" Foreground="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="✏️ Ganti Nama File" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).ShowRenameNoteDialogCommand}"/>
                                                <MenuItem Header="↩️ Undo Edit" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).UndoCommand}"/>
                                                <MenuItem Header="↪️ Redo Edit" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).RedoCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="🗑️ Hapus File Note" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).DeleteNoteCommand}"/>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="2" Content="➕ Note Baru" Command="{Binding CreateNewNoteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" CornerRadius="6"/>
                    </Grid>
                </Border>

                <!-- Kolom 3: Editor Note -->
                <Border Grid.Column="2" Background="#181825" CornerRadius="8" Padding="15">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <ProgressBar Grid.Row="0" IsIndeterminate="True" IsVisible="{Binding IsSaving}" Height="3" Margin="0,0,0,5"/>

                        <TextBox Grid.Row="0" Text="{Binding EditorTitle}" FontSize="18" FontWeight="Bold" Background="#313244" Foreground="White" Margin="0,0,0,10" CornerRadius="6"/>
                        
                        <TextBox Grid.Row="1" Text="{Binding EditorContent}" AcceptsReturn="True" TextWrapping="Wrap" Background="#313244" Foreground="White" CornerRadius="6">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="↩️ Undo" Command="{Binding UndoCommand}"/>
                                    <MenuItem Header="↪️ Redo" Command="{Binding RedoCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="💾 Simpan" Command="{Binding SaveCurrentNoteCommand}" IsEnabled="{Binding HasUnsavedChanges}"/>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>

                        <!-- Tombol Aksi Bawah -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                            <Button Content="↩️ Undo" Command="{Binding UndoCommand}" Background="#45475A" Foreground="White" CornerRadius="6"/>
                            <Button Content="↪️ Redo" Command="{Binding RedoCommand}" Background="#45475A" Foreground="White" CornerRadius="6"/>
                            <Button Content="🗑️ Hapus File" Command="{Binding DeleteNoteCommand}" Background="#F38BA8" Foreground="#11111B" CornerRadius="6"/>
                            <Button Content="💾 Simpan" Command="{Binding SaveCurrentNoteCommand}" IsEnabled="{Binding HasUnsavedChanges}" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" CornerRadius="6"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- TAMPILAN B: EXPLORER VIEW (KONTEN KHUSUS)  -->
            <!-- ========================================== -->
            <Grid IsVisible="{Binding !IsViewA}">
                <Border Background="#1E1E2E" CornerRadius="8" Padding="15">
                    <Grid RowDefinitions="Auto, *">
                        <!-- Navigation Bar Tampilan B -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
                            <Button Content="🔙 Kembali" Command="{Binding BackExplorerCommand}" IsEnabled="{Binding CanGoBack}" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" CornerRadius="6"/>
                            <TextBlock Text="{Binding CurrentExplorerPath}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- LEVEL 0: GRID LIST FOLDER -->
                        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsExplorerFolderLevel}">
                            <!-- CONTEXT MENU KLIK KANAN AREA KOSONG (BUAT FOLDER BARU) -->
                            <ScrollViewer.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="➕ Buat Folder Baru" Command="{Binding CreateNewFolderCommand}"/>
                                </ContextMenu>
                            </ScrollViewer.ContextMenu>

                            <ItemsControl ItemsSource="{Binding Folders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).OpenFolderExplorerCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                            <Border Width="140" Height="100" Background="#313244" CornerRadius="8" Margin="5" Padding="10">
                                                <!-- Context Menu Klik Kanan Tile Folder -->
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="➕ Buat Folder Baru" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).CreateNewFolderCommand}"/>
                                                        <Separator/>
                                                        <MenuItem Header="✏️ Ganti Nama Folder" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).ShowRenameFolderDialogCommand}"/>
                                                        <MenuItem Header="🗑️ Hapus Folder" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).DeleteFolderCommand}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                    
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
                                                    <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- LEVEL 1: GRID LIST FILE DALAM FOLDER -->
                        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsExplorerFileLevel}">
                            <!-- CONTEXT MENU KLIK KANAN AREA KOSONG (BUAT NOTE BARU) -->
                            <ScrollViewer.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="➕ Buat File Note Baru" Command="{Binding CreateNewNoteCommand}"/>
                                </ContextMenu>
                            </ScrollViewer.ContextMenu>

                            <ItemsControl ItemsSource="{Binding SelectedFolder.Notes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).OpenFileExplorerCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                            <Border Width="140" Height="100" Background="#45475A" CornerRadius="8" Margin="5" Padding="10">
                                                <!-- Context Menu Klik Kanan Tile File -->
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="➕ Buat File Note Baru" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).CreateNewNoteCommand}"/>
                                                        <Separator/>
                                                        <MenuItem Header="✏️ Ganti Nama File" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).ShowRenameNoteDialogCommand}"/>
                                                        <MenuItem Header="↩️ Undo Edit" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).UndoCommand}"/>
                                                        <MenuItem Header="↪️ Redo Edit" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).RedoCommand}"/>
                                                        <Separator/>
                                                        <MenuItem Header="🗑️ Hapus File Note" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).DeleteNoteCommand}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>

                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
                                                    <TextBlock Text="📄" FontSize="32" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" Foreground="#A6E3A1" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- LEVEL 2: EDITOR KHUSUS TAMPILAN B (FULL EXPLORER EDITOR) -->
                        <Border Grid.Row="1" Background="#181825" CornerRadius="8" Padding="15" IsVisible="{Binding IsExplorerEditorLevel}">
                            <Grid RowDefinitions="Auto, *, Auto">
                                <ProgressBar Grid.Row="0" IsIndeterminate="True" IsVisible="{Binding IsSaving}" Height="3" Margin="0,0,0,5"/>

                                <!-- Judul Note -->
                                <TextBox Grid.Row="0" Text="{Binding EditorTitle}" FontSize="18" FontWeight="Bold" Background="#313244" Foreground="White" Margin="0,0,0,10" CornerRadius="6"/>
                    
                                <!-- Isi Content Note -->
                                <TextBox Grid.Row="1" Text="{Binding EditorContent}" AcceptsReturn="True" TextWrapping="Wrap" Background="#313244" Foreground="White" CornerRadius="6">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="↩️ Undo" Command="{Binding UndoCommand}"/>
                                            <MenuItem Header="↪️ Redo" Command="{Binding RedoCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="💾 Simpan" Command="{Binding SaveCurrentNoteCommand}" IsEnabled="{Binding HasUnsavedChanges}"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>

                                <!-- Tombol Aksi Bawah Tampilan B -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                                    <Button Content="↩️ Undo" Command="{Binding UndoCommand}" Background="#45475A" Foreground="White" CornerRadius="6"/>
                                    <Button Content="↪️ Redo" Command="{Binding RedoCommand}" Background="#45475A" Foreground="White" CornerRadius="6"/>
                                    <Button Content="🗑️ Hapus File" Command="{Binding DeleteNoteCommand}" Background="#F38BA8" Foreground="#11111B" CornerRadius="6"/>
                                    <Button Content="💾 Simpan" Command="{Binding SaveCurrentNoteCommand}" IsEnabled="{Binding HasUnsavedChanges}" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <!-- POPUP MODAL RENAME DIALOG -->
            <Grid Background="#80000000" IsVisible="{Binding IsRenameOpen}">
                <Border Background="#1E1E2E" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="✏️ Ganti Nama" FontWeight="Bold" Foreground="White"/>
                        <TextBox Text="{Binding RenameInputText}" PlaceholderText="Masukkan nama baru..." Background="#313244" Foreground="White" CornerRadius="4"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Batal" Command="{Binding CancelRenameCommand}" Background="#313244" Foreground="White" CornerRadius="4"/>
                            <Button Content="Simpan" Command="{Binding ConfirmRenameCommand}" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" CornerRadius="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- POPUP MODAL WARNING UNSAVED CHANGES -->
            <Grid Background="#80000000" IsVisible="{Binding IsUnsavedWarningOpen}">
                <Border Background="#1E1E2E" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="⚠️ Perubahan Belum Disimpan" FontWeight="Bold" Foreground="#F38BA8" FontSize="14"/>
                        <TextBlock Text="Yakin pindah file? File ini belum disave, jika pindah perubahan sebelumnya akan dibatalkan." 
                                   TextWrapping="Wrap" Foreground="White" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,5,0,0">
                            <Button Content="Batal Pindah" Command="{Binding CancelDiscardChangesCommand}" Background="#313244" Foreground="White" CornerRadius="4"/>
                            <Button Content="Pindah Tanpa Simpan" Command="{Binding ConfirmDiscardChangesCommand}" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" CornerRadius="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>