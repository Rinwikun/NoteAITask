<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoteAITask.ViewModels"
             xmlns:views="using:NoteAITask.Views"
             x:Class="NoteAITask.Views.NoteView"
             x:DataType="vm:NoteViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- HEADER TOOLBAR -->
        <Border Grid.Row="0" Background="#1E1E2E" Padding="10,8" CornerRadius="8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="📝 Note" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="#45475A" VerticalAlignment="Center"/>
                    <TextBlock Text="Tip: Klik kanan pada Folder/File untuk opsi Rename, Undo, &amp; Hapus" 
                               Foreground="#89B4FA" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Dynamic Mode Buttons State -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Mode View:" Foreground="#A6ADC8" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button Content="📊 Split View - 3 Kolom" Command="{Binding SwitchToViewACommand}" 
                            Background="{Binding ViewABackground}" Foreground="White" FontWeight="Bold" CornerRadius="4"/>
                    <Button Content="📁 Explorer View - Bertingkat" Command="{Binding SwitchToViewBCommand}" 
                            Background="{Binding ViewBBackground}" Foreground="White" FontWeight="Bold" CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- AREA KONTEN TAMPILAN (DIPISAH KE USERCONTROL TERPISAH) -->
        <Grid Grid.Row="1">
            <!-- TAMPILAN A (SPLIT VIEW) -->
            <views:NoteViewA IsVisible="{Binding IsViewA}" DataContext="{Binding}" />

            <!-- TAMPILAN B (EXPLORER VIEW) -->
            <views:NoteViewB IsVisible="{Binding !IsViewA}" DataContext="{Binding}" />

            <!-- POPUP MODAL RENAME DIALOG -->
            <Grid Background="#80000000" IsVisible="{Binding IsRenameOpen}">
                <Border Background="#1E1E2E" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="✏️ Ganti Nama" FontWeight="Bold" Foreground="White"/>
                        <TextBox Text="{Binding RenameInputText}" PlaceholderText="Masukkan nama baru..." Background="#313244" Foreground="White" CornerRadius="4"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Batal" Command="{Binding CancelRenameCommand}" Background="#313244" Foreground="White" CornerRadius="4"/>
                            <Button Content="Simpan" Command="{Binding ConfirmRenameCommand}" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" CornerRadius="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- POPUP MODAL WARNING UNSAVED CHANGES -->
            <Grid Background="#80000000" IsVisible="{Binding IsUnsavedWarningOpen}">
                <Border Background="#1E1E2E" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="⚠️ Perubahan Belum Disimpan" FontWeight="Bold" Foreground="#F38BA8" FontSize="14"/>
                        <TextBlock Text="Yakin pindah file? File ini belum disave, jika pindah perubahan sebelumnya akan dibatalkan." 
                                   TextWrapping="Wrap" Foreground="White" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,5,0,0">
                            <Button Content="Batal Pindah" Command="{Binding CancelDiscardChangesCommand}" Background="#313244" Foreground="White" CornerRadius="4"/>
                            <Button Content="Pindah Tanpa Simpan" Command="{Binding ConfirmDiscardChangesCommand}" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" CornerRadius="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>