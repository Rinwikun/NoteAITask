<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoteAITask.ViewModels"
             x:Class="NoteAITask.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="#1E1E2E" Padding="25" CornerRadius="12" MaxWidth="520" 
                BorderBrush="#45475A" BorderThickness="1">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                
                <!-- ICON LOGO -->
                <Border Width="85" Height="85" CornerRadius="42" Background="#313244" HorizontalAlignment="Center" ClipToBounds="True">
                    <Image Source="/Assets/avalonia-logo.ico" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- HEADER TITLE & VERSION -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="#89B4FA" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- DESKRIPSI -->
                <TextBlock Text="{Binding Description}" Foreground="#A6ADC8" FontSize="12" 
                           TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"/>

                <Rectangle Height="1" Fill="#45475A" Margin="0,2"/>

                <!-- CREATOR INFO -->
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="Developed with ❤️ by" Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DeveloperName}" Foreground="#FAB387" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- SEKSI SUPPORT ME -->
                <Border Background="#2A2B3C" Padding="12" CornerRadius="8" Margin="0,4,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="☕ Support Development" FontWeight="Bold" Foreground="#A6E3A1" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Jika aplikasi ini membantu alur kerja Anda, dukung proyek ini agar terus berkembang!" 
                                   Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                        
                        <!-- TOMBOL ACTION (SIDE BY SIDE) -->
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="🌐 Visit GitHub" Command="{Binding OpenGitHubCommand}" 
                                    Background="#313244" Foreground="White" FontWeight="Bold" 
                                    CornerRadius="6" Padding="14,7" FontSize="11"/>

                            <Button Content="☕ Support Me (Saweria)" Command="{Binding OpenSupportCommand}" 
                                    Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" 
                                    CornerRadius="6" Padding="14,7" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>