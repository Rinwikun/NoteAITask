<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoteAITask.ViewModels"
             x:Class="NoteAITask.Views.NoteViewA"
             x:DataType="vm:NoteViewModel">

    <!-- ========================================== -->
    <!-- TAMPILAN A: SPLIT VIEW (3 KOLOM)           -->
    <!-- ========================================== -->
    <Grid ColumnDefinitions="200, 220, *">
        <!-- Kolom 1: Folder -->
        <Border Grid.Column="0" Background="#1E1E2E" CornerRadius="8" Margin="0,0,8,0" Padding="10">
            <Grid RowDefinitions="Auto, *, Auto">
                <TextBlock Grid.Row="0" Text="📁 Folder" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" Background="Transparent" Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="✏️ Ganti Nama Folder" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).ShowRenameFolderDialogCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ Hapus Folder" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).DeleteFolderCommand}"/>
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="➕ Folder Baru" Command="{Binding CreateNewFolderCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#313244" Foreground="White" CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- Kolom 2: File -->
        <Border Grid.Column="1" Background="#1E1E2E" CornerRadius="8" Margin="0,0,8,0" Padding="10">
            <Grid RowDefinitions="Auto, *, Auto">
                <TextBlock Grid.Row="0" Text="📝 File Note" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,10"/>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedFolder.Notes}" SelectedItem="{Binding SelectedNote}" Background="Transparent" Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="✏️ Ganti Nama File" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).ShowRenameNoteDialogCommand}"/>
                                        <MenuItem Header="↩️ Undo Edit" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).UndoCommand}"/>
                                        <MenuItem Header="↪️ Redo Edit" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).RedoCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ Hapus File Note" Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).DeleteNoteCommand}"/>
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="➕ Note Baru" Command="{Binding CreateNewNoteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- Kolom 3: Editor Note -->
        <Border Grid.Column="2" Background="#181825" CornerRadius="8" Padding="15">
            <Grid RowDefinitions="Auto, *, Auto">
                <ProgressBar Grid.Row="0" IsIndeterminate="True" IsVisible="{Binding IsSaving}" Height="3" Margin="0,0,0,5"/>

                <TextBox Grid.Row="0" Text="{Binding EditorTitle}" FontSize="18" FontWeight="Bold" Background="#313244" Foreground="White" Margin="0,0,0,10" CornerRadius="6"/>
                
                <TextBox Grid.Row="1" Text="{Binding EditorContent}" AcceptsReturn="True" TextWrapping="Wrap" Background="#313244" Foreground="White" CornerRadius="6">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="↩️ Undo" Command="{Binding UndoCommand}"/>
                            <MenuItem Header="↪️ Redo" Command="{Binding RedoCommand}"/>
                            <Separator/>
                            <MenuItem Header="💾 Simpan" Command="{Binding SaveCurrentNoteCommand}" IsEnabled="{Binding HasUnsavedChanges}"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>

                <!-- Tombol Aksi Bawah -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                    <Button Content="↩️ Undo" Command="{Binding UndoCommand}" Background="#45475A" Foreground="White" CornerRadius="6"/>
                    <Button Content="↪️ Redo" Command="{Binding RedoCommand}" Background="#45475A" Foreground="White" CornerRadius="6"/>
                    <Button Content="🗑️ Hapus File" Command="{Binding DeleteNoteCommand}" Background="#F38BA8" Foreground="#11111B" CornerRadius="6"/>
                    <Button Content="💾 Simpan" Command="{Binding SaveCurrentNoteCommand}" IsEnabled="{Binding HasUnsavedChanges}" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" CornerRadius="6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>